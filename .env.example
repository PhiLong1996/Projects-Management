# Copy this file to .env and adjust as needed. Unrecognized keys are
# ignored rather than crashing startup (see README §6).

# --- Database ---
# Overridden to Postgres by docker-compose.yml's `web.environment` block
# (postgresql+asyncpg://postgres:postgres@db:5432/taskdb) — "db" is only
# resolvable from inside the Compose network. Leave unset here for local
# SQLite dev (README §4), or point at localhost:5432 if you're running
# `uvicorn` directly against the `db` container (`docker compose up db -d`).
# DATABASE_URL=sqlite+aiosqlite:///./task_management.db

DB_ECHO=false

# --- Auth ---
SECRET_KEY=change-me-to-a-random-32-byte-value

# --- Admin seed (only used if the `users` table is empty on first boot) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# --- Outbound email (forgot-password, see README §7) ---
# Leave SMTP_HOST unset/blank to use the dev fallback: emails are
# logged/printed instead of sent, no mail server needed at all.
#
# docker-compose.yml already sets these three for you (pointing at the
# `mailpit` service it also starts) — you don't need to set them yourself
# to use `docker compose up --build`. They're spelled out here for the two
# cases where you DO need to set them:
#
#   1) Running `uvicorn` directly (README §4, no Docker) but still want to
#      send to the same Mailpit container (`docker compose up mailpit -d`):
#        SMTP_HOST=localhost
#        SMTP_PORT=1025
#        SMTP_USE_TLS=false
#
#   2) Sending through a real provider (Gmail app password, SendGrid,
#      Mailtrap, ...) instead of Mailpit, in any environment:
#        SMTP_HOST=smtp.your-provider.example
#        SMTP_PORT=587
#        SMTP_USER=your-smtp-username
#        SMTP_PASSWORD=your-smtp-password
#        SMTP_USE_TLS=true
#
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=false

# Base URL used to build the password-reset link emailed to users
# (<FRONTEND_URL>/reset-password?token=...).
FRONTEND_URL=http://localhost:3000
